# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
# Amazon Bedrock (chọn 1 trong 2 cách xác thực)
#AWS_BEARER_TOKEN_BEDROCK=          # API-key auth (ưu tiên nếu đặt)
#AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION=   # SigV4
# Bạn cần cài thêm: pip install "tradingagents[bedrock]"
# Provider keyless chạy cục bộ: groq/kimi/mistral/nvidia cần key riêng của nó
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#NVIDIA_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: vĩ mô Mỹ (FRED) và xác suất sự kiện (Polymarket) cho news/macro
# analyst. FRED miễn phí: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like vLLM or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-luna
# Chuỗi dự phòng provider (phân tách bởi dấu phẩy): khi chính build thất bại
# hoặc hết quota (cooldown 15 phút), hệ thống rơi sang provider kế tiếp với
# model mặc định trong catalog. Key của từng provider lấy từ các biến ở trên.
#TRADINGAGENTS_LLM_PROVIDER_FALLBACKS=deepseek,google,ollama
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=Tiếng Việt
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0
# 0.4.0: chặn output vô hạn (reasoning model) và retry khi burst 429
#TRADINGAGENTS_MAX_TOKENS=16384
#TRADINGAGENTS_LLM_MAX_RETRIES=3
